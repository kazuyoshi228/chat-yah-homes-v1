# Firebase クライアント設定（yah-homes プロジェクト）
# Firebase Console → プロジェクト設定 → ウェブアプリ から取得
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=yah-homes.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=yah-homes
VITE_FIREBASE_STORAGE_BUCKET=yah-homes.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check（reCAPTCHA Enterprise・公開サイトキー）
# 未設定なら App Check は初期化されない（段階的ロールアウト可）
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=6Lcpi4stAAAAAFduIp5DG5HhaUVA9nIyB49LT6F2
